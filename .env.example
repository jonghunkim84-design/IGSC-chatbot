# ─────────────────────────────────────────────────────────────
# 필수 (Vercel: Settings → Environment Variables, Production/Preview 모두)
# ─────────────────────────────────────────────────────────────
# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API (서버 전용)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 관리자 화면 접근 허용 이메일 (쉼표 구분)
ADMIN_ALLOWED_EMAILS=admin@example.com

# ─────────────────────────────────────────────────────────────
# 선택
# ─────────────────────────────────────────────────────────────
# 서비스의 공개 주소. 관리자 로그인 링크의 돌아올 주소로 쓴다. 비우면 요청 주소를 사용.
# NEXT_PUBLIC_SITE_URL=https://chat.example.com

# /chat 을 iframe 으로 열 수 있는 사이트 제한 (공백 구분). 비우면 모든 사이트 허용.
# CHAT_FRAME_ANCESTORS=https://www.customer.co.kr https://*.customer.co.kr

# 모델 변경 (기본값: 분류·FAQ 선택 claude-haiku-4-5-20251001, 답변 claude-sonnet-5-5)
# CLASSIFY_MODEL=
# SEARCH_MODEL=
# ANSWER_MODEL=

# 개발용 /api/search 를 운영에서 열 때만 true (운영에서는 설정하지 말 것)
# SEARCH_DEBUG_ENABLED=

# 요청 제한 (기본값; 필요할 때만 조정)
# RATE_CHAT_PER_MINUTE=15        # 한 IP 당 분당 채팅 질문
# RATE_CHAT_PER_HOUR=120         # 한 IP 당 시간당
# RATE_CHAT_GLOBAL_PER_DAY=3000  # 전체 하루 상한 (AI 비용 보호)
# RATE_LOGIN_PER_HOUR_IP=10      # 관리자 로그인 메일 요청 (IP)
# RATE_LOGIN_PER_HOUR_EMAIL=5    # 관리자 로그인 메일 요청 (이메일)

# 운영 모니터링 (docs/monitoring.md)
# CRON_SECRET=                 # 임의의 긴 문자열. 자동 점검(/api/cron/monitor) 호출 인증용 (Vercel 이 자동으로 붙여 보냄)
# RESEND_API_KEY=             # 관리자 이메일(ADMIN_ALLOWED_EMAILS)로 알림 메일을 보낼 때 (resend.com)
# ALERT_EMAIL_FROM=            # 보내는 주소 (인증한 도메인). 기본값은 Resend 테스트 주소
# ALERT_WEBHOOK_URL=           # (선택) Slack 호환 웹훅 주소. 이메일과 함께 쓸 수 있음
